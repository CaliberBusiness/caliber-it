# Copy to .env.local for local work. Never commit real values.
# NEXT_PUBLIC_* values are baked in at build time: change them, then redeploy.

# --- Site ---
# Required for production builds (the build fails without it). Origin only.
NEXT_PUBLIC_SITE_URL=https://it.caliberbusinessresource.com
# Set to "true" at launch. Anything else keeps every page noindex.
NEXT_PUBLIC_ALLOW_INDEX=

# --- GoHighLevel (server-only; NEVER prefix these with NEXT_PUBLIC_) ---
# Both required. Without them /api/lead returns 500 and no lead is captured.
# Private Integration token, scope contacts.write. Mark it "Sensitive" in Vercel.
GHL_PIT=
# The GHL sub-account (location) that receives the leads.
GHL_LOCATION_ID=

# --- Optional: GHL custom-field IDs ---
# Leave the three IT fields blank until the fields exist in GHL. While blank,
# each answer is written into the message as a labelled line instead.
# Message field. Defaults to Caliber's existing one; set only for another sub-account.
GHL_FIELD_MESSAGE=
GHL_FIELD_IT_SERVICE=
# Dropdown options must match the form exactly, en dashes included: 1–4, 5–20, 21–50, 51+
GHL_FIELD_IT_TEAM_SIZE=
GHL_FIELD_IT_CURRENT_TOOLS=
